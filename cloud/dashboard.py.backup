import os
import pandas as pd
import requests
import streamlit as st

API_URL = os.getenv("COLDCHAIN_API_URL", "http://127.0.0.1:8000")
API_KEY = os.getenv("COLDCHAIN_API_KEY", "replace-this-with-a-long-random-secret")

st.set_page_config(page_title="ColdChainGuard", page_icon="❄️", layout="wide")
st.title("❄️ ColdChainGuard — Cloud Dashboard")
st.caption("Cloud-side view of cold-chain sensor readings received by the API.")

with st.sidebar:
    st.subheader("Connection")
    st.write(f"API: `{API_URL}`")
    refresh = st.button("Refresh data")

try:
    health = requests.get(f"{API_URL}/health", timeout=4)
    online = health.ok
except requests.RequestException:
    online = False

if online:
    st.success("Cloud API online")
else:
    st.error("Cloud API unavailable. Check the API service and URL.")

headers = {"X-API-Key": API_KEY}
try:
    stats_response = requests.get(f"{API_URL}/stats", headers=headers, timeout=6)
    stats_response.raise_for_status()
    stats = stats_response.json()
    c1, c2, c3 = st.columns(3)
    c1.metric("Total readings", stats.get("total_readings", 0))
    c2.metric("Out-of-range readings", stats.get("out_of_range_readings", 0))
    c3.metric("Latest sensor timestamp", stats.get("latest_timestamp") or "—")

    response = requests.get(f"{API_URL}/readings?limit=500", headers=headers, timeout=6)
    response.raise_for_status()
    readings = response.json().get("readings", [])
    df = pd.DataFrame(readings)
    if df.empty:
        st.info("No readings received yet. Start the client simulator and fog gateway.")
    else:
        df["temperature"] = pd.to_numeric(df["temperature"], errors="coerce")
        df["timestamp"] = pd.to_datetime(df["timestamp"], errors="coerce", utc=True)
        df = df.sort_values("timestamp")
        st.subheader("Temperature over time")
        chart_data = df.dropna(subset=["timestamp"]).set_index("timestamp")[["temperature"]]
        st.line_chart(chart_data)
        st.subheader("Latest readings")
        st.dataframe(df.sort_values("timestamp", ascending=False), use_container_width=True)
        out_of_range = df[(df["temperature"] < 2) | (df["temperature"] > 8)]
        if not out_of_range.empty:
            st.warning(f"{len(out_of_range)} displayed reading(s) are outside the 2°C–8°C demo range.")
except requests.RequestException as exc:
    st.error(f"Could not retrieve cloud data: {exc}")
except ValueError as exc:
    st.error(f"Unexpected API response: {exc}")
